COMPOSE_PROJECT_NAME=nuageai-hermes

# Public URL used by n8n webhooks and editor.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# n8n auth. Change before any real deployment.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-32-plus-random-characters

# Database
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# Optional external services. Keep real values out of Git.
OPENAI_API_KEY=
SLACK_WEBHOOK_URL=
CRM_BASE_URL=
CRM_API_KEY=

